{
  "name": "claviron/symfony-link",
  "description": "Persistent Symfony application connected to Claviron Edge through Skene and Orbit",
  "type": "project",
  "license": "MIT OR Apache-2.0",
  "require": {
    "php": "^8.4",
    "claviron/bench": "^0.1",
    "claviron/symfony": "^0.1",
    "symfony/console": "8.2.x-dev",
    "symfony/framework-bundle": "8.2.x-dev"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "homepage": "https://github.com/claviron/symfony-link",
  "support": {
    "source": "https://github.com/claviron/symfony-link.git"
  }
}
