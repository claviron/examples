# Public demo settings only. Never put credentials or personal data here.
APP_NAME=OctaneExample
APP_ENV=local
APP_KEY=base64:Y2xhdmlyb24tZXhhbXBsZS1ub3QtYS1zZWNyZXQhISE=
APP_DEBUG=false
APP_URL=http://octane.test:8080

DB_CONNECTION=sqlite
DB_DATABASE=database/demo.sqlite
CACHE_STORE=claviron
SESSION_DRIVER=claviron
SESSION_STORE=claviron_sessions
SESSION_BLOCK=false
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
BROADCAST_CONNECTION=claviron

PUSHER_APP_KEY=example-key
PUSHER_APP_SECRET=example-secret
PUSHER_HOST=octane.test
PUSHER_PORT=8080

# Where each listener and door runs: `inherit` or `dedicated` (.env.dedicated,
# selected with --environment dedicated).
LISTENER_EXECUTION=inherit
