# Public loopback-only demonstration listener.
EDGE_HTTP_LISTEN=127.0.0.1:8080
EDGE_HTTPS_LISTEN=127.0.0.1:8443
EDGE_UDS_LISTEN=unix:/tmp/edge-server.sock
# Where each listener and door runs: `inherit` or `dedicated` (.env.dedicated,
# selected with --environment dedicated).
LISTENER_EXECUTION=inherit

# Upstream pools for one process that carries every request (shared).
# Warmup is optional and asynchronous: one H2 connection, or H1's live floor.
UPSTREAM_WARMUP=false
# HTTP/2 prior knowledge over UDS: streams per connection and pool ceiling.
UPSTREAM_UDS_MAX_STREAMS=128
UPSTREAM_UDS_MAX_IDLE=1024

# HTTP/1 over TCP: one in-flight request per connection.
UPSTREAM_TCP_MIN_IDLE=64
UPSTREAM_TCP_MAX_IDLE=1024

# HTTP/2 multiplexes: the pool fills a connection to MAX_STREAMS before it opens
# the next, up to the pool ceiling. MAX_IDLE bounds empty retention; it is not
# a warm floor. This example also uses it as the physical connection ceiling.
UPSTREAM_H2_MAX_STREAMS=128
UPSTREAM_H2_MAX_IDLE=32
