# Selected with --environment dedicated: each listener and door on its own thread.
LISTENER_EXECUTION=dedicated

# HTTP/2 over UDS, per serving worker: streams per connection and pool ceiling.
UPSTREAM_UDS_MAX_STREAMS=128
UPSTREAM_UDS_MAX_IDLE=128

# HTTP/1 over TCP: one in-flight request per connection. The live floor is
# maintained after the pool is first used.
UPSTREAM_TCP_MIN_IDLE=4
UPSTREAM_TCP_MAX_IDLE=128

# HTTP/2 per worker: up to 8 connections of 128 streams. The pool fills a
# connection before it opens the next, so connections grow with demand and
# spread over the application's workers. MAX_IDLE is a ceiling, not a floor.
UPSTREAM_H2_MAX_STREAMS=128
UPSTREAM_H2_MAX_IDLE=8
